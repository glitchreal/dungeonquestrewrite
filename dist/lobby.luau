local AbilityController = (function()
-- Matches the game's UIS / MobileLayout slot checks and localEvent activation.
local Abilities = {}

function Abilities.new(player, onConfirmed)
    local requests = setmetatable({}, { __mode = "k" })
    local slots, snapshots = {}, {}
    local lastRefresh, lastAttempt, preferred = -math.huge, -math.huge, "q"
    local descriptions = {}
    local metadataCache = setmetatable({}, { __mode = "k" })
    local userInput = game:GetService("UserInputService")
    local remotes = game:GetService("ReplicatedStorage"):WaitForChild("remotes")

    local function refresh(now)
        if now - lastRefresh < 0.05 then return end
        lastRefresh = now
        slots, snapshots = {}, {}
        local containers = { player:FindFirstChild("Backpack"), player.Character }
        for _, container in pairs(containers) do
            for _, tool in ipairs(container:GetChildren()) do
                local slot = tool:FindFirstChild("abilitySlot")
                local cooldown = tool:FindFirstChild("cooldown")
                if slot and cooldown and (slot.Value == "q" or slot.Value == "e") then
                    local remaining = math.max(0, tonumber(cooldown.Value) or 0)
                    local pending = requests[tool]
                    if pending and not pending.confirmed and remaining > 0 and now - pending.at < 1.5 then
                        pending.confirmed = true
                        onConfirmed(slot.Value, tool.Name)
                    end
                    slots[slot.Value] = tool
                    local cached = metadataCache[tool]
                    if not cached or now - cached.at > 1 then
                        local metadata = {}
                        for key, value in pairs(tool:GetAttributes()) do metadata[key:lower()] = value end
                        for _, child in ipairs(tool:GetChildren()) do
                            if child:IsA("ValueBase") then metadata[child.Name:lower()] = child.Value end
                        end
                        cached = { at = now, values = metadata }
                        metadataCache[tool] = cached
                    end
                    snapshots[slot.Value] = { name = tool.Name, cooldown = remaining, metadata = cached.values,
                        description = cached.values.description or descriptions[tool.Name] }
                end
            end
        end
    end

    return {
        SetInventory = function(inventory)
            descriptions = {}
            for _, item in pairs(inventory.abilities or {}) do
                if type(item.name) == "string" and type(item.description) == "string" then descriptions[item.name] = item.description end
            end
        end,
        Snapshot = function(now)
            refresh(now)
            return snapshots
        end,
        TryCast = function(now, interval, prepare)
            refresh(now)
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local busy = character and character:FindFirstChild("busyCasting")
            local peaceful = player:FindFirstChild("peaceful")
            if not humanoid or humanoid.Health <= 0 or (busy and busy.Value)
                or (peaceful and peaceful.Value) or userInput:GetFocusedTextBox() then return false end
            if now - lastAttempt < interval then return false end
            for _, slot in ipairs({ preferred, preferred == "q" and "e" or "q" }) do
                local tool = slots[slot]
                local snapshot = snapshots[slot]
                local pending = tool and requests[tool]
                if tool and snapshot.cooldown <= 0 and (not pending or now >= pending.retryAt)
                    and (not prepare or prepare(slot, snapshot)) then
                    local event = tool:FindFirstChild("localEvent")
                    local remote = remotes:FindFirstChild("abilityUsed")
                    if event and event:IsA("BindableEvent") and remote and remote:IsA("RemoteEvent") then
                        local length = tool:FindFirstChild("cooldownLength")
                        local retry = math.max(0.75, tonumber(length and length.Value) or 1)
                        requests[tool] = { at = now, retryAt = now + retry, confirmed = false }
                        lastAttempt, preferred = now, slot == "q" and "e" or "q"
                        event:Fire()
                        remote:FireServer(slot, tool)
                        return true
                    end
                end
            end
            return false
        end,
    }
end

return Abilities

end)()
local PartySync = (function()
-- Same-workspace files are the fastest sync path and need no background process.
-- The HTTP relay remains a fallback when executor instances isolate their files.
local PartySync = {}

local function relayKind(url)
    if url:match("^https://[^/]+$") then return "remote" end
    local host, port = url:match("^http://([^/:]+):(%d+)$")
    if not host or tonumber(port) < 1 or tonumber(port) > 65535 then return nil end
    if host == "localhost" or host == "127.0.0.1" or host == "10.0.2.2" then return "local" end
    local a, b, c, d = host:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$")
    a, b, c, d = tonumber(a), tonumber(b), tonumber(c), tonumber(d)
    if not a or a > 255 or b > 255 or c > 255 or d > 255 then return nil end
    if a == 10 or a == 192 and b == 168 or a == 172 and b >= 16 and b <= 31 then return "local" end
end

local function wallTime()
    if DateTime and type(DateTime.now) == "function" then return DateTime.now().UnixTimestampMillis / 1000 end
    return os.time()
end

function PartySync.new(config, mode, isAlive)
    local Http = game:GetService("HttpService")
    local player = game:GetService("Players").LocalPlayer
    local sync = { status = "Sync off" }
    local context, response, receivedAt, pending, acknowledged, lastAttempt = nil, nil, nil, nil, false, -math.huge
    local generation = 0
    local files = {
        available = type(writefile) == "function" and type(readfile) == "function"
            and type(isfile) == "function" and type(makefolder) == "function",
        room = nil, shared = false, lastWrite = -math.huge,
    }

    local function signature()
        return table.concat({ tostring(config.SyncEnabled), config.SyncURL, config.SyncKey,
            config.Role, config.Host, config.Carry, config.Alts }, "|")
    end
    local lastSignature = signature()
    local function reset()
        local value = signature()
        if value ~= lastSignature then
            lastSignature = value; generation = generation + 1
            context, response, receivedAt, pending, acknowledged = nil, nil, nil, nil, false
            lastAttempt = -math.huge
            files.room, files.shared, files.lastWrite = nil, false, -math.huge
        end
    end
    local function ensureFolder(path)
        if type(isfolder) == "function" and isfolder(path) then return true end
        return pcall(makefolder, path)
    end
    local function readJSON(path)
        if not files.available or not path or not isfile(path) then return nil end
        local ok, value = pcall(function() return Http:JSONDecode(readfile(path)) end)
        return ok and type(value) == "table" and value or nil
    end
    local function writeJSON(path, value)
        if not files.available or not path then return false end
        return pcall(function() writefile(path, Http:JSONEncode(value)) end)
    end
    local function setupRoom(ids, hostId, carryId)
        if not files.available then return end
        local sorted = table.clone(ids)
        table.sort(sorted)
        local root = "DungeonQuestRewrite-sync"
        local room = root .. "/" .. hostId .. "_" .. carryId .. "_" .. table.concat(sorted, "-")
        if not ensureFolder(root) or not ensureFolder(room) then files.available = false; return end
        files.room = room
    end
    local function heartbeatPath(id) return files.room and (files.room .. "/" .. id .. ".json") end
    local function commandPath() return files.room and (files.room .. "/command.json") end
    local function fresh(entry, limit)
        if type(entry) ~= "table" or type(entry.at) ~= "number" then return false end
        local age = wallTime() - entry.at
        return age >= -5 and age <= limit
    end
    local function writeHeartbeat(now)
        if not files.room or not context or now - files.lastWrite < 0.25 then return end
        files.lastWrite = now
        writeJSON(heartbeatPath(player.UserId), {
            version = 1, userId = player.UserId, jobId = game.JobId, placeId = game.PlaceId, mode = mode,
            enabled = config.Enabled, ready = config.Enabled and context.ready and now - context.at < 2,
            at = wallTime(),
        })
    end
    local function fileReadiness(roster)
        if not files.room then return false, nil end
        local missing, visible = {}, 0
